# Development environment. Usage: cp .env.dev.example .env && docker compose up -d
# Every variable is documented in .env.prod.example.

# Mailpit catches all outgoing mail: http://localhost:8025
COMPOSE_PROFILES=mailpit

# Local URL, plain HTTP on port 8107.
WP_URL=http://localhost:8107
SITE_ADDRESS=:80
HTTP_PORT=8107
HTTPS_PORT=8407
MAILPIT_PORT=8025

# Pinned Easy Digital Downloads version (enforced on every `up`).
EDD_VERSION=3.7.1

WP_ENVIRONMENT_TYPE=local
WP_DEBUG=1
WP_DISALLOW_FILE_EDIT=false

# Dev-only credentials.
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=none
SMTP_FROM=shop@example.com
SMTP_FROM_NAME=Easy Digital Downloads (dev)

# Optional overrides (see overrides/*.yaml), combined with ":".
#COMPOSE_FILE=compose.yaml:overrides/plugin.yaml
#PLUGIN_PATH=../my-plugin
#PLUGIN_NAME=my-plugin
